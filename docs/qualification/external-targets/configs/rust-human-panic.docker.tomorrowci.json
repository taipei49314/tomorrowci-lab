{
  "baseline": {
    "dependencies": "locked",
    "runtime": "1.83"
  },
  "candidates": {
    "dependencies": {
      "latest_allowed": false,
      "prerelease": false
    },
    "runtime": {
      "channels": [
        "stable"
      ],
      "max_versions": 1
    }
  },
  "execution": {
    "max_parallel": 1,
    "max_scenarios": 4,
    "reruns_on_failure": 2,
    "timeout_seconds": 900
  },
  "policy": {
    "fail_if": {
      "baseline_invalid": true,
      "blocked_ratio_above": 0.0,
      "horizon_regression": true,
      "new_future_failure": true
    }
  },
  "project": {
    "build_command": "auto",
    "ecosystem": "rust",
    "test_command": "cargo test --locked"
  },
  "report": {
    "html": true,
    "json": true,
    "sarif": false
  },
  "sandbox": {
    "cpus": 2.0,
    "engine": "docker",
    "memory_mb": 4096,
    "network": "fetch-only",
    "pids_limit": 512
  },
  "version": 1
}
